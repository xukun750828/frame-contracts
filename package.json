{
  "name": "@frame/contracts",
  "version": "0.1.0",
  "description": "Shared interchange and Ground Truth contracts for FRAME products.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --import tsx --test tests/*.test.ts",
    "schema:json": "tsx scripts/generate-json-schema.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run schema:json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
